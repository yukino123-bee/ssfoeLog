{
    "name": "home/communifund-assistance-system",
    "authors": [
        {
            "name": "Dev Bot",
            "email": "devnull@example.com"
        }
    ],
    "require": {
        "setasign/fpdf": "^1.8",
        "setasign/fpdi": "^2.6",
        "phpoffice/phpword": "^1.4"
    },
    "config": {
        "process-timeout": 0
    },
    "scripts": {
        "setup": [
            "@composer install",
            "@php -r \"foreach (['storage/logs', 'storage/rate_limits', 'storage/uploads/requests'] as $dir) { if (!is_dir($dir)) { mkdir($dir, 0750, true); } }\""
        ],
        "start": "@php -S 127.0.0.1:8080 -t public public/router.php",
        "serve": "@start",
        "check": "find app public routes -type f -name '*.php' -print0 | xargs -0 -n1 php -l"
    }
}
